{
  "name": "mystora-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:vendor && node scripts/build-production.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i ./tailwind.input.css -o ./assets/css/tailwind.css --minify",
    "build:vendor": "node scripts/copy-vendor.mjs",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./tailwind.input.css -o ./assets/css/tailwind.css --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "http-server": "14.1.1",
    "tailwindcss": "3.4.19"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "gsap": "3.12.2",
    "lenis": "1.3.26"
  }
}
